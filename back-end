from flask import Flask, render_template
import os

app = Flask(__name__)


@app.route('/')
def home():
    """Home page."""
    return render_template('home.html')


@app.route('/t-levels')
def t_levels_page():
    """What T Levels are, grading, industry placement."""
    return render_template('T-levels.html')


@app.route('/programmes')
def programmes_page():
    """Amazon T Level placement areas."""
    return render_template('programmes.html')


@app.route('/faq')
def faq_page():
    """Frequently asked questions."""
    return render_template('FAQ.html')


@app.route('/contact')
def contact_page():
    """Contact / enquiry form."""
    return render_template('contact.html')


# ---------- Error handling ----------

@app.errorhandler(404)
def page_not_found(error):
    """Friendly page when a URL doesn't exist."""
    return render_template('404.html'), 404


@app.errorhandler(500)
def server_error(error):
    """Friendly page when something breaks on the server."""
    return render_template('500.html'), 500


if __name__ == '__main__':
    # Debug mode only when explicitly turned on, never in production
    app.run(debug=os.environ.get('FLASK_DEBUG') == '1')
