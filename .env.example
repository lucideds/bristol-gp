# Copy this file to .env and fill in the values. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional: the public URL of the site, sent to OpenRouter as the HTTP-Referer header.
OPENROUTER_SITE_URL=
SECRET_KEY=change-me
# Slack bot (bot/bot.py): posts contact form messages to a channel. Leave blank to turn it off.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# Analytics page (/analytics): comma-separated account emails allowed to open it. Leave blank and nobody can.
ANALYTICS_EMAILS=
