# Copy this file to .env and fill in the values. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional: the public URL of the site, sent to OpenRouter as the HTTP-Referer header.
OPENROUTER_SITE_URL=
# Signs the sign-in cookie. Leave blank and the app makes one and saves it to .env on first start.
# Never use a value from this file or the repo: anyone who knows it can fake being signed in.
SECRET_KEY=
# Slack bot (bot/bot.py): posts contact form messages to a channel. Leave blank to turn it off.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
